rules_version = '2';

// Craft2Cart catalog data. Every document lives under the artisan who owns it,
// so one owner check at the top covers products, buyers and the profile.
// Nothing here is world-readable: a signed-out visitor gets nothing, which is
// why the app keeps a local-only demo mode instead of reading shared data.

service cloud.firestore {
  match /databases/{database}/documents {

    match /artisans/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Anything not matched above is denied.
  }
}
