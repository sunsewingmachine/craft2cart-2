# Copy to .env.local and fill in. .env.local is gitignored.

# --- Gemini (server-side only, never exposed to the browser) ---
# GEMINI_API_KEY: Required for Gemini AI API calls (smart cataloging).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional. Defaults to gemini-flash-latest.
# Verify a candidate id before pinning it: node scripts/check-gemini.mjs --probe
GEMINI_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Firebase web app (client-side; safe to ship, guarded by security rules) ---
# Get these with:
#   firebase apps:sdkconfig WEB --project <your-project-id>
# Leave them blank to run the app in demo mode: no login, local-only storage.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
